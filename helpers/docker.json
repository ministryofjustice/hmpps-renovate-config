{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "packageRules": [
    {
      "labels": ["platform-updates"],
      "matchDatasources": ["docker","docker-compose"],
      "groupName": "Platform Updates",
      "matchUpdateTypes": [
        "digest",
        "patch",
        "minor"
      ],     
      "recreateWhen": "always",
      "automerge": true
    },
    {
      "description":"Update node 24 alpine runtime images to the hardened container images that have date suffix",
      "labels": ["platform-updates-replacement-1"],
      "matchDatasources": ["docker","docker-compose"],
      "matchPackageNames": ["ghcr.io/ministryofjustice/hmpps-node"],
      "groupName": "Platform Updates",
      "groupSlug": "platform-updates",
      "matchCurrentValue": "24-alpine-runtime*",
      "replacementName": "ghcr.io/ministryofjustice/hmpps-hardened-container-images/node-alpine-runtime",
      "replacementVersion": "24-apko-main",
      "recreateWhen": "always",
      "pinDigests": true,
      "automerge": true,
      "platformAutomerge": true
    },
    {
      "description":"Update node-alpine 24 images to the hardened container images, usually is used for build stage",
      "labels": ["platform-updates-replacement-2"],
      "matchDatasources": ["docker","docker-compose"],
      "groupName": "Platform Updates",
      "groupSlug": "platform-updates",
      "matchPackageNames": ["ghcr.io/ministryofjustice/hmpps-node"],
      "matchCurrentValue": "24-alpine",
      "replacementName": "ghcr.io/ministryofjustice/hmpps-hardened-container-images/node-alpine",
      "replacementVersion": "24-npm11-apko-main",
      "recreateWhen": "always",
      "pinDigests": true,
      "automerge": true,
      "platformAutomerge": true
    },
    {
      "description": "Update node 24 alpine images to the hardened container images that have date suffix, usually is used for build stage",
      "labels": ["platform-updates-replacement-3"],
      "matchDatasources": ["docker","docker-compose"],
      "groupName": "Platform Updates",
      "groupSlug": "platform-updates",
      "matchPackageNames": ["ghcr.io/ministryofjustice/hmpps-node"],
      "matchCurrentValue": "24-alpine-[0-9]*",
      "replacementName": "ghcr.io/ministryofjustice/hmpps-hardened-container-images/node-alpine",
      "replacementVersion": "24-npm11-apko-main",
      "recreateWhen": "always",
      "pinDigests": true,
      "automerge": true,
      "platformAutomerge": true
    },
    {
      "description":"Update node 26 alpine runtime images to the hardened container images that have date suffix",
      "labels": ["platform-updates-replacement-4"],
      "matchDatasources": ["docker","docker-compose"],
      "matchPackageNames": ["ghcr.io/ministryofjustice/hmpps-node"],
      "groupName": "Platform Updates",
      "groupSlug": "platform-updates",
      "matchCurrentValue": "26-alpine-runtime*",
      "replacementName": "ghcr.io/ministryofjustice/hmpps-hardened-container-images/node-alpine-runtime",
      "replacementVersion": "26-apko-main",
      "recreateWhen": "always",
      "pinDigests": true,
      "automerge": true,
      "platformAutomerge": true
    },
    {
      "description":"Update node-alpine 26 images to the hardened container images, usually is used for build stage",
      "labels": ["platform-updates-replacement-5"],
      "matchDatasources": ["docker","docker-compose"],
      "groupName": "Platform Updates",
      "groupSlug": "platform-updates",
      "matchPackageNames": ["ghcr.io/ministryofjustice/hmpps-node"],
      "matchCurrentValue": "26-alpine",
      "replacementName": "ghcr.io/ministryofjustice/hmpps-hardened-container-images/node-alpine",
      "replacementVersion": "26-npm12-apko-main",
      "recreateWhen": "always",
      "pinDigests": true,
      "automerge": true,
      "platformAutomerge": true
    },
    {
      "description": "Update node 26 alpine images to the hardened container images that are usually used for build stage",
      "labels": ["platform-updates-replacement-6"],
      "matchDatasources": ["docker","docker-compose"],
      "groupName": "Platform Updates",
      "groupSlug": "platform-updates",
      "matchPackageNames": ["ghcr.io/ministryofjustice/hmpps-node"],
      "matchCurrentValue": "26-alpine-[0-9]*",
      "replacementName": "ghcr.io/ministryofjustice/hmpps-hardened-container-images/node-alpine",
      "replacementVersion": "26-npm12-apko-main",
      "recreateWhen": "always",
      "pinDigests": true,
      "automerge": true,
      "platformAutomerge": true
    },
    {
      "description": "If using public node 24 alpine images, update to the hardened container images that are usually used for build stage",
      "labels": ["platform-updates-replacement-7"],
      "matchDatasources": ["docker","docker-compose"],
      "groupName": "Platform Updates",
      "groupSlug": "platform-updates",
      "matchPackageNames": ["^node"],
      "matchCurrentValue": "24-alpine",
      "replacementName": "ghcr.io/ministryofjustice/hmpps-hardened-container-images/node-alpine",
      "replacementVersion": "24-npm11-apko-main",
      "recreateWhen": "always",
      "pinDigests": true,
      "automerge": true,
      "platformAutomerge": true
    }
,
    {
      "description": "If using public node 26 alpine images, update to the hardened container images that are usually used for build stage",
      "labels": ["platform-updates-replacement-8"],
      "matchDatasources": ["docker","docker-compose"],
      "groupName": "Platform Updates",
      "groupSlug": "platform-updates",
      "matchPackageNames": ["^node"],
      "matchCurrentValue": "26-alpine",
      "replacementName": "ghcr.io/ministryofjustice/hmpps-hardened-container-images/node-alpine",
      "replacementVersion": "26-npm12-apko-main",
      "recreateWhen": "always",
      "pinDigests": true,
      "automerge": true,
      "platformAutomerge": true
    }
  ]
}
