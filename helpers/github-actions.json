{
  "$schema": "https://renovatebot.com",
  "extends": [
    "config:recommended"
  ],
  "packageRules": [
    {
      "description": "Automerge minor, patch, and digest updates to GitHub Actions",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "groupName": "Platform Updates",
      "groupSlug": "platform-updates",
      "automerge": true,
      "platformAutomerge": true,
      "minimumReleaseAge": "7 days"
    }
  ]
}
