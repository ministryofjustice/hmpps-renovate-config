{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "packageRules": [
    {
      "labels": ["renovate-rule-github-actions-01"],
      "description": "Automerge minor, patch, and digest updates to GitHub Actions excluding ministryofjustice/hmpps-github-actions as we don't pin digests",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch", "digest", "major"],
      "excludePackageNames": ["ministryofjustice/hmpps-github-actions/*"],
      "groupName": "Platform Updates",
      "groupSlug": "platform-updates",
      "automerge": true,
      "platformAutomerge": true,
      "minimumReleaseAge": "7 days",
      "pinDigests": true
    },
    {
      "labels": ["renovate-rule-github-actions-02"],
      "description": "Automerge minor, patch, and digest updates to GitHub Actions only ministryofjustice/hmpps-github-actions as we don't pin digests",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch", "digest", "major"],
      "matchPackageNames": ["ministryofjustice/hmpps-github-actions/*"],
      "groupName": "Platform Updates",
      "groupSlug": "platform-updates",
      "automerge": true,
      "platformAutomerge": true,
      "minimumReleaseAge": "7 days",
      "pinDigests": false
    }
  ]
}
