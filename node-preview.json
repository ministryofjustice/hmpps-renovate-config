{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>ministryofjustice/hmpps-renovate-config:base"],
  "enabledManagers": ["npm", "nvm", "dockerfile", "docker-compose", "helmv3", "helm-values", "github-actions", "pre-commit"],
  
  "packageRules": [
    {
      "matchDepTypes": ["engines"],
      "enabled": false
    },
    {
      "matchDatasources": ["npm"],
      "minimumReleaseAge": "7 days"
    },
    {
      "matchDatasources": ["npm"],
      "matchPackageNames": ["@ministryofjustice/**"],
      "registryUrls": ["https://registry.npmjs.org"]
    },
    {
      "matchDatasources": ["npm"],
      "matchPackageNames": ["@ministryofjustice/hmpps-security-assurance-db-client"],
      "registryUrls": ["https://npm.pkg.github.com"]
    },
    {
      "matchManagers": ["github-actions"],
      "matchFileNames": [
        "**/.github/workflows/**/*.ya?ml",
        "**/.github/actions/**/*.ya?ml"
      ],
      "groupName": "github-actions",
      "groupSlug": "github-actions",
      "minimumReleaseAge": "7 days",
      "pinDigests": true,
      "pinVersions": true,
      "rebaseWhen": "conflicted",
      "automerge": true,
      "automergeStrategy": "squash",
      "automergeComment": "Automatically merged by Renovate",
      "automergeType": "branch"
    },
    {
      "matchDatasources": ["docker","docker-compose"],
      "priority": 1,
      "matchPackageNames": ["ghcr.io/ministryofjustice/hmpps-node"],
      "groupName": "heat-1708",
      "groupSlug": "heat-1708",
      "matchCurrentValue": "24-alpine-runtime",
      "replacementName": "ghcr.io/ministryofjustice/hmpps-hardened-container-images/node-alpine-runtime",
      "replacementVersion": "24-apko-main",
      "pinDigests": true
    },
    {
      "matchDatasources": ["docker","docker-compose"],
      "priority": 1,
      "groupName": "heat-1708",
      "groupSlug": "heat-1708",
      "matchPackageNames": ["ghcr.io/ministryofjustice/hmpps-node"],
      "matchCurrentValue": "24-alpine",
      "replacementName": "ghcr.io/ministryofjustice/hmpps-hardened-container-images/node-alpine",
      "replacementVersion": "24-npm11-apko-main",
      "pinDigests": true
    }
  ]
}
