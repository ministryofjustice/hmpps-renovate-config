{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>ministryofjustice/hmpps-renovate-config:base#f-test-renovate",
    "github>ministryofjustice/hmpps-renovate-config://helpers/docker.json#f-test-renovate",
    "github>ministryofjustice/hmpps-renovate-config://helpers/node.json#f-test-renovate",
    "github>ministryofjustice/hmpps-renovate-config://helpers/helm.json#f-test-renovate",
    "github>ministryofjustice/hmpps-renovate-config://helpers/github-actions.json#f-test-renovate"
  ],
  "enabledManagers": ["npm", "nvm", "dockerfile", "docker-compose", "helmv3", "helm-values", "github-actions", "pre-commit"],
  "prHourlyLimit": 0,
  "packageRules": [
    {
      "labels": ["renovate-rule-1"],
      "matchDepTypes": ["engines"],
      "enabled": false
    },
    {
      "labels": ["renovate-rule-2"],
      "matchDatasources": ["npm"],
      "minimumReleaseAge": "7 days"
    },
    {
      "labels": ["renovate-rule-3"],
      "matchDatasources": ["npm"],
      "matchUpdateTypes": [
        "digest",
        "patch",
        "minor"
      ],
      "matchPackageNames": ["@ministryofjustice/**"],
      "registryUrls": ["https://registry.npmjs.org"]
    },
    {
      "labels": ["renovate-rule-4"],
      "matchDatasources": ["npm"],
      "matchPackageNames": ["@ministryofjustice/hmpps-security-assurance-db-client"],
      "registryUrls": ["https://npm.pkg.github.com"]
    },
    {
      "labels": ["renovate-rule-5"],
      "matchManagers": ["github-actions"],
      "matchFileNames": [
        "**/.github/workflows/**/*.ya?ml",
        "**/.github/actions/**/*.ya?ml"
      ],
      "groupName": "github-actions",
      "groupSlug": "github-actions",
      "minimumReleaseAge": "7 days",
      "pinDigests": true,
      "pinVersions": true,
      "recreateWhen": "always",
      "automerge": true,
      "automergeStrategy": "squash",
      "automergeComment": "Automatically merged by Renovate",
      "automergeType": "branch"
    },
    {
      "labels": ["renovate-rule-6"],
      "matchDatasources": ["docker","docker-compose"],
      "groupName": "docker-updates",
      "matchUpdateTypes": [
        "digest",
        "patch",
        "minor"
      ],     
      "pinDigests": true,
      "pinVersions": true,
      "recreateWhen": "always",
      "automerge": true
    }    
  ]
}
